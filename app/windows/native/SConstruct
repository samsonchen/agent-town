#!/usr/bin/env python
# Builds the TownWindow add-on into ../addons/town_window/bin/.
# From this folder:  scons platform=windows target=template_release arch=x86_64   (or arch=arm64)
# The DLLs it writes are committed, so building the Godot project does not need a C++ compiler.

env = SConscript("godot-cpp/SConstruct", {"api_version": "4.4"})
env.Append(CPPPATH=["src/"])
if env["platform"] == "windows":
    env.Append(LIBS=["user32", "comctl32"])

library = env.SharedLibrary(
    "../addons/town_window/bin/town_window{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=Glob("src/*.cpp"),
)
env.NoCache(library)
Default(library)
